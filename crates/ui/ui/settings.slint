import { Theme } from "common.slint";

component SectionHeader inherits Rectangle {
    in property <string> label: "";
    height: 32px;

    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component SettingRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    callback edit;

    height: 36px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.value;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 60px;
            height: 26px;
            border-radius: 6px;
            background: Theme.bg-panel;

            TouchArea {
                clicked => { root.edit(); }
            }

            Text {
                text: "Edit";
                color: Theme.accent;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component Stepper inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> hint: "";
    callback inc;
    callback dec;

    height: 52px;

    VerticalLayout {
        spacing: 2px;

        HorizontalLayout {
            spacing: 10px;

            Text {
                text: root.label;
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 30px;
                height: 26px;
                border-radius: 6px;
                background: Theme.bg-panel;
                TouchArea { clicked => { root.dec(); } }
                Text {
                    text: "−";
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                min-width: 64px;
                horizontal-alignment: center;
            }

            Rectangle {
                width: 30px;
                height: 26px;
                border-radius: 6px;
                background: Theme.bg-panel;
                TouchArea { clicked => { root.inc(); } }
                Text {
                    text: "+";
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if (root.hint != "") : Text {
            text: root.hint;
            color: Theme.text-dim;
            font-size: 10px;
        }
    }
}

export component SettingsScreen inherits Rectangle {
    in property <string> license-status: "Unlicensed";
    in property <string> license-error: "";
    in property <string> audio-device: "Default";
    in property <string> audio-engine: "rodio";
    in-out property <[string]> devices;
    in-out property <string> selected-device: "";
    in-out property <string> device-note: "";
    in-out property <string> xfade-label: "3.0 s";
    in-out property <string> silence-label: "10 s";

    callback activate-license(string);
    callback clear-license;
    callback select-device(string);
    callback refresh-devices;
    callback xfade-inc;
    callback xfade-dec;
    callback silence-inc;
    callback silence-dec;

    background: Theme.bg-primary;

    Flickable {
        VerticalLayout {
            padding: 20px;
            spacing: 18px;

            Text {
                text: "⚙ Settings";
                color: Theme.text-primary;
                font-size: 20px;
                font-weight: 800;
            }

            // --- License ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    SectionHeader {
                        label: "🔑 License";
                    }

                    SettingRow {
                        label: "Status";
                        value: root.license-status;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 6px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;

                                key-input := TextInput {
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 100px;
                            height: 36px;
                            border-radius: 6px;
                            background: Theme.accent;

                            TouchArea {
                                clicked => { root.activate-license(key-input.text); }
                            }

                            Text {
                                text: "Activate";
                                color: white;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 80px;
                            height: 36px;
                            border-radius: 6px;
                            background: Theme.bg-panel;

                            TouchArea {
                                clicked => { root.clear-license(); }
                            }

                            Text {
                                text: "Clear";
                                color: Theme.text-dim;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if (root.license-error != "") : Text {
                        text: root.license-error;
                        color: Theme.accent;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            // --- Audio ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    SectionHeader {
                        label: "🔊 Audio";
                    }

                    SettingRow {
                        label: "Engine";
                        value: root.audio-engine + " (restart flag --engine to switch)";
                    }

                    SettingRow {
                        label: "Active output";
                        value: root.audio-device;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        Text {
                            text: "Output devices — tap to select";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 80px;
                            height: 26px;
                            border-radius: 6px;
                            background: Theme.bg-panel;
                            TouchArea { clicked => { root.refresh-devices(); } }
                            Text {
                                text: "Refresh";
                                color: Theme.accent;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for d in root.devices : Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: d == root.selected-device ? Theme.bg-panel : transparent;
                            border-width: 1px;
                            border-color: d == root.selected-device ? Theme.accent : transparent;
                            TouchArea { clicked => { root.select-device(d); } }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: d == root.selected-device ? "●" : "○";
                                    color: d == root.selected-device ? Theme.accent : Theme.text-dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: d;
                                    color: d == root.selected-device ? Theme.text-primary : Theme.text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    if (root.device-note != "") : Text {
                        text: root.device-note;
                        color: Theme.warning;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Stepper {
                        label: "Crossfade";
                        value: root.xfade-label;
                        hint: "Blend length for play-while-playing and queued takeovers";
                        inc => { root.xfade-inc(); }
                        dec => { root.xfade-dec(); }
                    }

                    Stepper {
                        label: "Silence alarm";
                        value: root.silence-label;
                        hint: "Dead-air seconds before auto-recovery (cpal engine only)";
                        inc => { root.silence-inc(); }
                        dec => { root.silence-dec(); }
                    }
                }
            }

            // --- About ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    SectionHeader {
                        label: "ℹ About";
                    }

                    Text {
                        text: "CrabBoss v0.1.0";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }

                    Text {
                        text: "Radio Automation Software — Rust + Slint";
                        color: Theme.text-dim;
                        font-size: 12px;
                    }

                    Text {
                        text: "github.com/sonyarianto/crabboss";
                        color: Theme.accent;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
