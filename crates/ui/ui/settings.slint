import { Theme } from "common.slint";

component SectionHeader inherits Rectangle {
    in property <string> label: "";
    height: 32px;

    Text {
        text: root.label;
        color: Theme.text-primary;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component SettingRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    callback edit;

    height: 36px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.value;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 60px;
            height: 26px;
            border-radius: 6px;
            background: Theme.bg-panel;

            TouchArea {
                clicked => { root.edit(); }
            }

            Text {
                text: "Edit";
                color: Theme.accent;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component Stepper inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> hint: "";
    callback inc;
    callback dec;

    height: 52px;

    VerticalLayout {
        spacing: 2px;

        HorizontalLayout {
            spacing: 10px;

            Text {
                text: root.label;
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 30px;
                height: 26px;
                border-radius: 6px;
                background: Theme.bg-panel;
                TouchArea { clicked => { root.dec(); } }
                Text {
                    text: "−";
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                min-width: 64px;
                horizontal-alignment: center;
            }

            Rectangle {
                width: 30px;
                height: 26px;
                border-radius: 6px;
                background: Theme.bg-panel;
                TouchArea { clicked => { root.inc(); } }
                Text {
                    text: "+";
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if (root.hint != "") : Text {
            text: root.hint;
            color: Theme.text-dim;
            font-size: 10px;
        }
    }
}

component EqBandControl inherits VerticalLayout {
    in property <int> band;
    in property <string> freq;
    in property <string> gain;
    callback inc;
    callback dec;

    spacing: 2px;

    Text {
        text: root.freq;
        color: Theme.text-dim;
        font-size: 9px;
        horizontal-alignment: center;
    }

    Rectangle {
        width: 30px;
        height: 22px;
        border-radius: 5px;
        background: Theme.bg-panel;
        TouchArea { clicked => { root.dec(); } }
        Text {
            text: "−";
            color: Theme.accent;
            font-size: 13px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.gain;
        color: root.gain == "+0" ? Theme.text-dim : Theme.text-primary;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Rectangle {
        width: 30px;
        height: 22px;
        border-radius: 5px;
        background: Theme.bg-panel;
        TouchArea { clicked => { root.inc(); } }
        Text {
            text: "+";
            color: Theme.accent;
            font-size: 13px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component SettingsScreen inherits Rectangle {
    in property <string> license-status: "Unlicensed";
    in property <string> license-error: "";
    in property <string> audio-device: "Default";
    in property <string> audio-engine: "rodio";
    in-out property <[string]> devices;
    in-out property <string> selected-device: "";
    in-out property <string> device-note: "";
    in-out property <string> xfade-label: "3.0 s";
    in-out property <string> silence-label: "10 s";
    in-out property <bool> eq-on: false;
    in-out property <[string]> eq-gains;
    in-out property <string> limiter-label: "-0.1 dBFS";
    in-out property <bool> loudness-on: false;
    in-out property <string> stream-status: "⏸ Off";
    in-out property <string> stream-stats: "";
    in-out property <bool> stream-enabled: false;
    in-out property <string> stream-host: "127.0.0.1";
    in-out property <string> stream-port: "8000";
    in-out property <string> stream-mount: "/stream";
    in-out property <string> stream-password: "";
    in-out property <string> stream-bitrate: "128 kbps";

    callback stream-toggle;
    callback stream-host-committed(string);
    callback stream-port-committed(string);
    callback stream-mount-committed(string);
    callback stream-password-committed(string);
    callback stream-bitrate-inc;
    callback stream-bitrate-dec;
    callback activate-license(string);
    callback clear-license;
    callback select-device(string);
    callback refresh-devices;
    callback xfade-inc;
    callback xfade-dec;
    callback silence-inc;
    callback silence-dec;
    callback eq-toggle;
    callback eq-inc(int);
    callback eq-dec(int);
    callback eq-reset;
    callback limiter-inc;
    callback limiter-dec;
    callback loudness-toggle;

    background: Theme.bg-primary;

    Flickable {
        VerticalLayout {
            padding: 20px;
            spacing: 18px;

            Text {
                text: "⚙ Settings";
                color: Theme.text-primary;
                font-size: 20px;
                font-weight: 800;
            }

            // --- License ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    SectionHeader {
                        label: "🔑 License";
                    }

                    SettingRow {
                        label: "Status";
                        value: root.license-status;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 6px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;

                                key-input := TextInput {
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 100px;
                            height: 36px;
                            border-radius: 6px;
                            background: Theme.accent;

                            TouchArea {
                                clicked => { root.activate-license(key-input.text); }
                            }

                            Text {
                                text: "Activate";
                                color: white;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 80px;
                            height: 36px;
                            border-radius: 6px;
                            background: Theme.bg-panel;

                            TouchArea {
                                clicked => { root.clear-license(); }
                            }

                            Text {
                                text: "Clear";
                                color: Theme.text-dim;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if (root.license-error != "") : Text {
                        text: root.license-error;
                        color: Theme.accent;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            // --- Audio ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    SectionHeader {
                        label: "🔊 Audio";
                    }

                    SettingRow {
                        label: "Engine";
                        value: root.audio-engine + " (restart flag --engine to switch)";
                    }

                    SettingRow {
                        label: "Active output";
                        value: root.audio-device;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        Text {
                            text: "Output devices — tap to select";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 80px;
                            height: 26px;
                            border-radius: 6px;
                            background: Theme.bg-panel;
                            TouchArea { clicked => { root.refresh-devices(); } }
                            Text {
                                text: "Refresh";
                                color: Theme.accent;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        for d in root.devices : Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: d == root.selected-device ? Theme.bg-panel : transparent;
                            border-width: 1px;
                            border-color: d == root.selected-device ? Theme.accent : transparent;
                            TouchArea { clicked => { root.select-device(d); } }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: d == root.selected-device ? "●" : "○";
                                    color: d == root.selected-device ? Theme.accent : Theme.text-dim;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: d;
                                    color: d == root.selected-device ? Theme.text-primary : Theme.text-secondary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    if (root.device-note != "") : Text {
                        text: root.device-note;
                        color: Theme.warning;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Stepper {
                        label: "Crossfade";
                        value: root.xfade-label;
                        hint: "Blend length for play-while-playing and queued takeovers";
                        inc => { root.xfade-inc(); }
                        dec => { root.xfade-dec(); }
                    }

                    Stepper {
                        label: "Silence alarm";
                        value: root.silence-label;
                        hint: "Dead-air seconds before auto-recovery (cpal engine only)";
                        inc => { root.silence-inc(); }
                        dec => { root.silence-dec(); }
                    }
                }
            }

            // --- DSP (EQ + limiter, cpal engine) ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "🎚 DSP";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 90px;
                            height: 26px;
                            border-radius: 6px;
                            background: root.eq-on ? Theme.accent : Theme.bg-panel;
                            TouchArea { clicked => { root.eq-toggle(); } }
                            Text {
                                text: root.eq-on ? "EQ ON" : "EQ OFF";
                                color: root.eq-on ? white : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 70px;
                            height: 26px;
                            border-radius: 6px;
                            background: Theme.bg-panel;
                            TouchArea { clicked => { root.eq-reset(); } }
                            Text {
                                text: "Flat";
                                color: Theme.accent;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "12-band program EQ (cpal engine) — ±12 dB per band";
                        color: Theme.text-dim;
                        font-size: 10px;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        for i in [0, 1, 2, 3, 4, 5]: EqBandControl {
                            freq: ["31", "44", "62", "125", "250", "500"][i];
                            gain: i < root.eq-gains.length ? root.eq-gains[i] : "+0";
                            inc => { root.eq-inc(i); }
                            dec => { root.eq-dec(i); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        for i in [6, 7, 8, 9, 10, 11]: EqBandControl {
                            freq: ["1k", "2k", "3.2k", "4k", "8k", "16k"][i - 6];
                            gain: i < root.eq-gains.length ? root.eq-gains[i] : "+0";
                            inc => { root.eq-inc(i); }
                            dec => { root.eq-dec(i); }
                        }
                    }

                    Stepper {
                        label: "Limiter ceiling";
                        value: root.limiter-label;
                        hint: "Program-bus brickwall (cpal engine); lower = more protection";
                        inc => { root.limiter-inc(); }
                        dec => { root.limiter-dec(); }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Loudness normalization";
                            color: Theme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 110px;
                            height: 26px;
                            border-radius: 6px;
                            background: root.loudness-on ? Theme.accent : Theme.bg-panel;
                            TouchArea { clicked => { root.loudness-toggle(); } }
                            Text {
                                text: root.loudness-on ? "ON (R128)" : "OFF";
                                color: root.loudness-on ? white : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "Per-track gain toward −23 LUFS (EBU R128) from the library 🔊 scan — analyze tracks from Media Manager first";
                        color: Theme.text-dim;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }

            // --- Streaming (Icecast, cpal engine) ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "📡 Streaming";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 110px;
                            height: 26px;
                            border-radius: 6px;
                            background: root.stream-enabled ? Theme.accent : Theme.bg-panel;
                            TouchArea { clicked => { root.stream-toggle(); } }
                            Text {
                                text: root.stream-enabled ? "STREAM ON" : "STREAM OFF";
                                color: root.stream-enabled ? white : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.stream-status;
                            color: root.stream-status == "🔴 Live" ? #4caf50 : Theme.text-secondary;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.stream-stats;
                            color: Theme.text-dim;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Broadcast the program mix to an Icecast server (MP3). Server + bitrate changes apply on restart of the stream.";
                        color: Theme.text-dim;
                        font-size: 10px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        // Host
                        Rectangle {
                            horizontal-stretch: 2;
                            height: 34px;
                            border-radius: 6px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                stream-host-input := TextInput {
                                    text: root.stream-host;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    // Commit on Enter or focus loss via accepted.
                                    accepted() => { root.stream-host-committed(stream-host-input.text); }
                                }
                            }
                        }
                        // Port
                        Rectangle {
                            width: 76px;
                            height: 34px;
                            border-radius: 6px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                stream-port-input := TextInput {
                                    text: root.stream-port;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    input-type: number;
                                    accepted() => { root.stream-port-committed(stream-port-input.text); }
                                }
                            }
                        }
                        // Mount
                        Rectangle {
                            width: 110px;
                            height: 34px;
                            border-radius: 6px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                stream-mount-input := TextInput {
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    accepted() => { root.stream-mount-committed(stream-mount-input.text); }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        // Password
                        Rectangle {
                            horizontal-stretch: 2;
                            height: 34px;
                            border-radius: 6px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                stream-password-input := TextInput {
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    input-type: password;
                                    accepted() => { root.stream-password-committed(stream-password-input.text); }
                                }
                            }
                        }
                        // Bitrate stepper (compact)
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                width: 30px;
                                height: 26px;
                                border-radius: 6px;
                                background: Theme.bg-panel;
                                TouchArea { clicked => { root.stream-bitrate-dec(); } }
                                Text {
                                    text: "−";
                                    color: Theme.accent;
                                    font-size: 14px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.stream-bitrate;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                width: 74px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 30px;
                                height: 26px;
                                border-radius: 6px;
                                background: Theme.bg-panel;
                                TouchArea { clicked => { root.stream-bitrate-inc(); } }
                                Text {
                                    text: "+";
                                    color: Theme.accent;
                                    font-size: 14px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Server: host / port / mount (press Enter to save each field) — source user is fixed to 'source'";
                        color: Theme.text-dim;
                        font-size: 10px;
                    }
                }
            }

            // --- About ---
            Rectangle {
                background: Theme.bg-secondary;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    SectionHeader {
                        label: "ℹ About";
                    }

                    Text {
                        text: "CrabBoss v0.1.0";
                        color: Theme.text-secondary;
                        font-size: 13px;
                    }

                    Text {
                        text: "Radio Automation Software — Rust + Slint";
                        color: Theme.text-dim;
                        font-size: 12px;
                    }

                    Text {
                        text: "github.com/sonyarianto/crabboss";
                        color: Theme.accent;
                        font-size: 12px;
                    }
                }
            }
        }
    }
}
