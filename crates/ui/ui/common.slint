// CrabBoss — Common theme colors as a global singleton
// Muted Windows-dark-mode palette: neutral grays, single restrained blue.

export global Theme {
    out property <color> bg-primary: #202020;
    out property <color> bg-secondary: #282828;
    out property <color> bg-panel: #2e2e2e;
    out property <color> bg-input: #2b2b2b;
    out property <color> accent: #338fda;
    out property <color> accent-hover: #4b9fe3;
    out property <color> text-primary: #ffffff;
    out property <color> text-secondary: #b4b4b4;
    out property <color> text-dim: #7a7a7a;
    out property <color> success: #5cae67;
    out property <color> warning: #c19a2b;
    out property <color> border: #3f3f3f;
}
