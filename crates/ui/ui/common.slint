// CrabBoss — Common theme colors as a global singleton

export global Theme {
    out property <color> bg-primary: #1a1a2e;
    out property <color> bg-secondary: #16213e;
    out property <color> bg-panel: #0f3460;
    out property <color> bg-input: #1a1a3e;
    out property <color> accent: #e94560;
    out property <color> accent-hover: #ff6b81;
    out property <color> text-primary: #eaeaea;
    out property <color> text-secondary: #a0a0b0;
    out property <color> text-dim: #606070;
    out property <color> success: #00d2a0;
    out property <color> warning: #f0a500;
    out property <color> border: #2a2a4a;
}
