import { Theme } from "common.slint";

export struct AdRow {
    name: string,
    time: string,
    dates: string,
    spot: string,
    days: string,
    enabled: bool,
    mon: bool,
    tue: bool,
    wed: bool,
    thu: bool,
    fri: bool,
    sat: bool,
    sun: bool,
    spot-full: string,
    intro-full: string,
    outro-full: string,
    start-full: string,
    end-full: string,
}

component SmallBtn inherits Rectangle {
    in property <string> label: "";
    in property <bool> highlighted: false;
    in property <bool> danger: false;
    callback clicked;

    height: 24px;
    border-radius: 4px;
    background: highlighted ? Theme.success : Theme.bg-panel;

    TouchArea { clicked => { root.clicked(); } }

    Text {
        text: root.label;
        color: highlighted ? white : (danger ? Theme.text-dim : Theme.accent);
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BlockRow inherits Rectangle {
    in property <string> b-name: "";
    in property <string> b-time: "";
    in property <string> b-dates: "";
    in property <string> b-spot: "";
    in property <string> b-days: "";
    in property <bool> b-enabled: false;
    in property <int> b-index: 0;
    in property <bool> is-even: false;

    callback toggle-requested(int);
    callback delete-requested(int);
    callback run-requested(int);
    callback edit-requested(int);

    height: 40px;
    background: is-even ? Theme.bg-primary : Theme.bg-secondary;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.b-enabled ? Theme.success : Theme.text-dim;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.b-time;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
            width: 46px;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.b-name + "  •  " + root.b-dates;
                color: Theme.text-primary;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.b-spot + "  •  " + root.b-days;
                color: Theme.text-dim;
                font-size: 10px;
                overflow: elide;
            }
        }

        SmallBtn {
            width: 44px;
            label: "Run";
            clicked => { root.run-requested(root.b-index); }
        }

        SmallBtn {
            width: 34px;
            label: "Edit";
            clicked => { root.edit-requested(root.b-index); }
        }

        SmallBtn {
            width: 40px;
            label: root.b-enabled ? "On" : "Off";
            highlighted: root.b-enabled;
            clicked => { root.toggle-requested(root.b-index); }
        }

        SmallBtn {
            width: 26px;
            label: "✕";
            danger: true;
            clicked => { root.delete-requested(root.b-index); }
        }
    }
}

component Field inherits Rectangle {
    in-out property <string> value: "";

    height: 30px;
    border-radius: 6px;
    background: Theme.bg-input;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        TextInput {
            text <=> root.value;
            color: Theme.text-primary;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component DayToggle inherits Rectangle {
    in property <string> label: "";
    in property <bool> on: false;
    callback toggled;

    width: 36px;
    height: 26px;
    border-radius: 6px;
    background: root.on ? Theme.accent : Theme.bg-panel;

    TouchArea { clicked => { root.toggled(); } }

    Text {
        text: root.label;
        color: root.on ? white : Theme.text-secondary;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AdsScreen inherits Rectangle {
    in-out property <[AdRow]> blocks;
    in-out property <bool> show-editor: false;
    in-out property <string> editor-error: "";

    in-out property <int> editing-index: -1;
    in-out property <string> edit-name: "";
    in-out property <string> edit-spot: "";
    in-out property <string> edit-intro: "";
    in-out property <string> edit-outro: "";
    in-out property <string> edit-start: "";
    in-out property <string> edit-end: "";
    in-out property <string> edit-time: "08:00";
    in-out property <bool> edit-mon: true;
    in-out property <bool> edit-tue: true;
    in-out property <bool> edit-wed: true;
    in-out property <bool> edit-thu: true;
    in-out property <bool> edit-fri: true;
    in-out property <bool> edit-sat: true;
    in-out property <bool> edit-sun: true;

    callback toggle-block(int);
    callback delete-block(int);
    callback run-block(int);
    callback save-block(int, string, string, string, string, string, string, string, bool, bool, bool, bool, bool, bool, bool);

    background: Theme.bg-primary;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            alignment: space-between;

            Text {
                text: "📢 Ad Blocks";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                width: 90px;
                height: 28px;
                border-radius: 6px;
                background: Theme.accent;
                TouchArea {
                    clicked => {
                        root.editing-index = -1;
                        root.edit-name = "";
                        root.edit-spot = "";
                        root.edit-intro = "";
                        root.edit-outro = "";
                        root.edit-start = "";
                        root.edit-end = "";
                        root.edit-time = "08:00";
                        root.edit-mon = true;
                        root.edit-tue = true;
                        root.edit-wed = true;
                        root.edit-thu = true;
                        root.edit-fri = true;
                        root.edit-sat = true;
                        root.edit-sun = true;
                        root.editor-error = "";
                        root.show-editor = true;
                    }
                }
                Text {
                    text: "+ Add";
                    color: white;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: "Spot plays between optional intro/outro stings, inside its date window";
            color: Theme.text-dim;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            if (root.blocks.length == 0) : Text {
                text: "No ad blocks — click + Add, e.g. spot with 2026 dates";
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Flickable {
                VerticalLayout {
                    spacing: 0px;
                    for b[i] in root.blocks : BlockRow {
                        b-name: b.name;
                        b-time: b.time;
                        b-dates: b.dates;
                        b-spot: b.spot;
                        b-days: b.days;
                        b-enabled: b.enabled;
                        b-index: i;
                        is-even: mod(i, 2) == 0;
                        toggle-requested(idx) => { root.toggle-block(idx); }
                        delete-requested(idx) => { root.delete-block(idx); }
                        run-requested(idx) => { root.run-block(idx); }
                        edit-requested(idx) => {
                            root.editing-index = idx;
                            root.edit-name = b.name;
                            root.edit-time = b.time;
                            root.edit-start = b.start-full;
                            root.edit-end = b.end-full;
                            root.edit-spot = b.spot-full;
                            root.edit-intro = b.intro-full;
                            root.edit-outro = b.outro-full;
                            root.edit-mon = b.mon;
                            root.edit-tue = b.tue;
                            root.edit-wed = b.wed;
                            root.edit-thu = b.thu;
                            root.edit-fri = b.fri;
                            root.edit-sat = b.sat;
                            root.edit-sun = b.sun;
                            root.editor-error = "";
                            root.show-editor = true;
                        }
                    }
                }
            }
        }
    }

    if (root.show-editor) : Rectangle {
        background: #00000099;

        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 440px;
                    height: 560px;
                    border-radius: 10px;
                    background: Theme.bg-secondary;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;

                        Text {
                            text: root.editing-index < 0 ? "Add ad block" : "Edit ad block";
                            color: Theme.text-primary;
                            font-size: 15px;
                            font-weight: 800;
                        }

                        Text { text: "Name"; color: Theme.text-dim; font-size: 11px; }
                        Field { value <=> root.edit-name; }

                        Text { text: "Spot audio path (required)"; color: Theme.text-dim; font-size: 11px; }
                        Field { value <=> root.edit-spot; }

                        Text { text: "Intro sting (optional)"; color: Theme.text-dim; font-size: 11px; }
                        Field { value <=> root.edit-intro; }

                        Text { text: "Outro sting (optional)"; color: Theme.text-dim; font-size: 11px; }
                        Field { value <=> root.edit-outro; }

                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                Text { text: "Start (YYYY-MM-DD)"; color: Theme.text-dim; font-size: 11px; }
                                Field { value <=> root.edit-start; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                Text { text: "End (YYYY-MM-DD)"; color: Theme.text-dim; font-size: 11px; }
                                Field { value <=> root.edit-end; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                Text { text: "Time (HH:MM)"; color: Theme.text-dim; font-size: 11px; }
                                Field { value <=> root.edit-time; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            Text { text: "Repeat days"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                            SmallBtn {
                                width: 60px;
                                label: "Daily";
                                clicked => {
                                    root.edit-mon = true;
                                    root.edit-tue = true;
                                    root.edit-wed = true;
                                    root.edit-thu = true;
                                    root.edit-fri = true;
                                    root.edit-sat = true;
                                    root.edit-sun = true;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            DayToggle { label: "Mon"; on: root.edit-mon; toggled => { root.edit-mon = !root.edit-mon; } }
                            DayToggle { label: "Tue"; on: root.edit-tue; toggled => { root.edit-tue = !root.edit-tue; } }
                            DayToggle { label: "Wed"; on: root.edit-wed; toggled => { root.edit-wed = !root.edit-wed; } }
                            DayToggle { label: "Thu"; on: root.edit-thu; toggled => { root.edit-thu = !root.edit-thu; } }
                            DayToggle { label: "Fri"; on: root.edit-fri; toggled => { root.edit-fri = !root.edit-fri; } }
                            DayToggle { label: "Sat"; on: root.edit-sat; toggled => { root.edit-sat = !root.edit-sat; } }
                            DayToggle { label: "Sun"; on: root.edit-sun; toggled => { root.edit-sun = !root.edit-sun; } }
                        }

                        if (root.editor-error != "") : Text {
                            text: root.editor-error;
                            color: Theme.accent;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Rectangle {
                                width: 90px;
                                height: 30px;
                                border-radius: 6px;
                                background: Theme.bg-panel;
                                TouchArea {
                                    clicked => {
                                        root.show-editor = false;
                                        root.editor-error = "";
                                    }
                                }
                                Text {
                                    text: "Cancel";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 90px;
                                height: 30px;
                                border-radius: 6px;
                                background: Theme.accent;
                                TouchArea {
                                    clicked => {
                                        root.save-block(root.editing-index, root.edit-name, root.edit-spot, root.edit-intro, root.edit-outro, root.edit-start, root.edit-end, root.edit-time, root.edit-mon, root.edit-tue, root.edit-wed, root.edit-thu, root.edit-fri, root.edit-sat, root.edit-sun);
                                    }
                                }
                                Text {
                                    text: "Save";
                                    color: white;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
