import { Theme } from "common.slint";

component TrackRow inherits Rectangle {
    in property <string> title: "";
    in property <string> artist: "";
    in property <string> duration: "";
    in property <bool> is-even: false;
    in property <bool> is-selected: false;

    callback clicked;

    height: 36px;
    background: is-selected ? Theme.bg-panel : (is-even ? Theme.bg-primary : Theme.bg-secondary);

    animate background { duration: 100ms; }

    TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: root.title;
            color: is-selected ? Theme.accent : Theme.text-primary;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 3;
            overflow: elide;
        }

        Text {
            text: root.artist;
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 2;
            overflow: elide;
        }

        Text {
            text: root.duration;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component SearchBar inherits Rectangle {
    in property <string> placeholder-text: "Search tracks...";
    out property <string> text <=> input.text;

    callback search-changed(string);

    height: 36px;
    border-radius: 6px;
    background: Theme.bg-input;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: "🔍";
            color: Theme.text-dim;
            font-size: 14px;
            vertical-alignment: center;
        }

        input := TextInput {
            color: Theme.text-primary;
            font-size: 13px;
            vertical-alignment: center;
            edited => { root.search-changed(root.text); }
        }
    }
}

component ListHeader inherits Rectangle {
    height: 28px;
    background: Theme.bg-secondary;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: "Title";
            color: Theme.text-dim;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 3;
        }

        Text {
            text: "Artist";
            color: Theme.text-dim;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 2;
        }

        Text {
            text: "Duration";
            color: Theme.text-dim;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component LibraryPanel inherits Rectangle {
    in property <string> track-count: "0 tracks";

    callback search-changed(string);
    callback track-selected(int);
    callback track-double-clicked(int);
    callback import-files;

    background: Theme.bg-primary;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            height: 32px;
            alignment: space-between;

            Text {
                text: "📚 Library — " + root.track-count;
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                width: 80px;
                height: 28px;
                border-radius: 6px;
                background: Theme.accent;

                TouchArea {
                    clicked => { root.import-files(); }
                }

                Text {
                    text: "+ Import";
                    color: white;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        SearchBar {
            search-changed(text) => { root.search-changed(text); }
        }

        ListHeader {}

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            Flickable {
                VerticalLayout {
                    spacing: 0px;

                    TrackRow {
                        title: "Import audio files to get started";
                        artist: "";
                        duration: "";
                        is-even: true;
                    }
                }
            }
        }
    }
}
