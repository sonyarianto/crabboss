import { Theme } from "common.slint";

export struct CartRow {
    label: string,
    sub: string,
    has-file: bool,
    progress: float,
    playing: bool,
}

component CartCell inherits Rectangle {
    in property <int> slot: 0;
    in property <string> cart-label: "";
    in property <string> cart-sub: "";
    in property <bool> filled: false;
    in property <bool> has-file: false;
    in property <float> progress: 0.0;
    in property <bool> playing: false;
    in property <bool> assign-mode: false;
    in property <bool> armed: false;

    callback play(int);
    callback remove(int);
    callback add;
    callback place(int);

    height: 110px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: (root.assign-mode && root.armed && ta.has-hover) ? Theme.bg-panel : Theme.bg-secondary;
    border-width: 2px;
    border-color: (root.assign-mode && root.armed && ta.has-hover) ? Theme.success
        : root.playing ? Theme.accent
        : (filled ? Theme.border : Theme.text-dim);

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    VerticalLayout {
        // color strip by slot
        Rectangle {
            height: 6px;
            border-radius: 4px;
            background: mod(root.slot, 4) == 0 ? Theme.accent : (mod(root.slot, 4) == 1 ? Theme.success : (mod(root.slot, 4) == 2 ? Theme.warning : Theme.bg-panel));
        }

        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 6px;
            spacing: 2px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 4px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    // Hotkey number badge (keys 1–8 fire these pads)
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 4px;
                        background: Theme.bg-input;
                        Text {
                            text: root.slot < 9 ? "\{root.slot + 1}" : "";
                            color: Theme.text-dim;
                            font-size: 9px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.filled ? root.cart-label : "Empty";
                        color: root.filled ? Theme.text-primary : Theme.text-dim;
                        font-size: 13px;
                        font-weight: 800;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if (root.filled && !root.assign-mode) : Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    background: Theme.bg-panel;
                    TouchArea { clicked => { root.remove(root.slot); } }
                    Text {
                        text: "✕";
                        color: Theme.text-dim;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.filled ? root.cart-sub : "Click to load from library";
                color: Theme.text-dim;
                font-size: 10px;
                overflow: elide;
                vertical-stretch: 1;
            }

            // Per-pad progress: fills while this pad's clip plays.
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.bg-input;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0.0, 1.0);
                    border-radius: 2px;
                    background: root.playing ? Theme.accent : Theme.success;
                }
            }

            Text {
                text: root.assign-mode && root.armed
                    ? "＋ PLACE HERE"
                    : root.filled
                        ? (root.has-file ? "▶ TAP TO PLAY" : "⚠ file missing")
                        : "＋ TAP TO LOAD";
                color: root.assign-mode && root.armed
                    ? Theme.success
                    : root.filled
                        ? (root.has-file ? Theme.accent : Theme.warning)
                        : Theme.text-dim;
                font-size: 10px;
                font-weight: 700;
            }
        }
    }

    ta := TouchArea {
        clicked => {
            if (root.assign-mode && root.armed) {
                root.place(root.slot);
            } else if (root.filled) {
                root.play(root.slot);
            } else {
                root.add();
            }
        }
    }
}

export component CartScreen inherits Rectangle {
    in-out property <[CartRow]> carts;
    in-out property <string> status: "";
    in property <bool> assign-mode: false;
    in property <bool> armed: false;
    in property <string> armed-label: "";

    callback play-cart(int);
    callback delete-cart(int);
    callback add-cart;
    callback place-cart(int);
    callback toggle-assign;

    background: Theme.bg-primary;

    forward-focus: keys;
    init => { keys.focus(); }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            alignment: space-between;

            Text {
                text: "🎛 Cart Wall";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                Rectangle {
                    width: 96px;
                    height: 28px;
                    border-radius: 6px;
                    background: root.assign-mode ? Theme.success : Theme.bg-panel;
                    TouchArea { clicked => { root.toggle-assign(); } }
                    Text {
                        text: root.assign-mode ? "🎯 Assigning" : "🎯 Assign";
                        color: root.assign-mode ? white : Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 150px;
                    height: 28px;
                    border-radius: 6px;
                    background: Theme.accent;
                    TouchArea { clicked => { root.add-cart(); } }
                    Text {
                        text: "+ Load next track";
                        color: white;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: root.status != "" ? root.status
                : root.assign-mode && root.armed
                    ? "Placing '\{root.armed-label}' — tap a pad (Esc cancels)"
                    : root.assign-mode
                        ? "Tap a track in the Library, then tap a pad"
                        : "Keys 1–8 fire pads · 🎯 Assign places any library track on any pad";
            color: Theme.text-dim;
            font-size: 11px;
        }

        keys := FocusScope {
            key-pressed(e) => {
                if (e.text == "1") {
                    root.play-cart(0);
                    accept
                } else if (e.text == "2") {
                    root.play-cart(1);
                    accept
                } else if (e.text == "3") {
                    root.play-cart(2);
                    accept
                } else if (e.text == "4") {
                    root.play-cart(3);
                    accept
                } else if (e.text == "5") {
                    root.play-cart(4);
                    accept
                } else if (e.text == "6") {
                    root.play-cart(5);
                    accept
                } else if (e.text == "7") {
                    root.play-cart(6);
                    accept
                } else if (e.text == "8") {
                    root.play-cart(7);
                    accept
                }
                reject
            }
        }

        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    for i in 4 : CartCell {
                        slot: i;
                        filled: i < root.carts.length;
                        cart-label: i < root.carts.length ? root.carts[i].label : "";
                        cart-sub: i < root.carts.length ? root.carts[i].sub : "";
                        has-file: i < root.carts.length ? root.carts[i].has-file : false;
                        progress: i < root.carts.length ? root.carts[i].progress : 0.0;
                        playing: i < root.carts.length ? root.carts[i].playing : false;
                        assign-mode: root.assign-mode;
                        armed: root.armed;
                        play(idx) => { root.play-cart(idx); }
                        remove(idx) => { root.delete-cart(idx); }
                        add => { root.add-cart(); }
                        place(idx) => { root.place-cart(idx); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    for i in 4 : CartCell {
                        slot: i + 4;
                        filled: i + 4 < root.carts.length;
                        cart-label: i + 4 < root.carts.length ? root.carts[i + 4].label : "";
                        cart-sub: i + 4 < root.carts.length ? root.carts[i + 4].sub : "";
                        has-file: i + 4 < root.carts.length ? root.carts[i + 4].has-file : false;
                        progress: i + 4 < root.carts.length ? root.carts[i + 4].progress : 0.0;
                        playing: i + 4 < root.carts.length ? root.carts[i + 4].playing : false;
                        assign-mode: root.assign-mode;
                        armed: root.armed;
                        play(idx) => { root.play-cart(idx); }
                        remove(idx) => { root.delete-cart(idx); }
                        add => { root.add-cart(); }
                        place(idx) => { root.place-cart(idx); }
                    }
                }
            }
        }
    }
}
