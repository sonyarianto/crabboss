import { Theme } from "common.slint";
import { HomeScreen } from "home.slint";
import { PlayerPanel } from "player.slint";
import { LibraryPanel, LibTrack } from "library.slint";
import { PlaylistPanel } from "playlist.slint";
import { SettingsScreen } from "settings.slint";
import { SchedulerScreen, SchedRow } from "scheduler.slint";
import { CartScreen, CartRow } from "cart.slint";
import { ReportScreen, ReportRow } from "report.slint";
import { AdsScreen, AdRow } from "ads.slint";

component NavButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked;

    height: 30px;
    border-radius: 6px;
    background: active ? Theme.accent : transparent;

    TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: active ? white : Theme.text-secondary;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "CrabBoss — Radio Automation";
    min-width: 900px;
    min-height: 600px;
    background: Theme.bg-primary;

    // -- Router: 1=home, 2=playout, 3=media, 4=settings, 5=scheduler, 6=cartwall, 7=reports, 8=ads --
    in-out property <int> current-screen: 1;
    in-out property <string> station-name: "CrabBoss FM";
    in-out property <string> license-status: "Unlicensed";
    in-out property <string> license-error: "";
    in-out property <string> audio-engine: "rodio";
    in-out property <string> audio-device: "Default";

    // -- Home stats --
    in-out property <int> track-count: 0;
    in-out property <int> playlist-count: 0;
    in-out property <int> upcoming-count: 0;

    // -- Player state properties --
    in-out property <bool> is-playing: false;
    in-out property <string> now-playing-title: "No track loaded";
    in-out property <string> now-playing-artist: "";
    in-out property <string> current-time: "00:00";
    in-out property <string> total-time: "00:00";
    in-out property <float> player-volume: 0.8;
    in-out property <float> player-progress: 0.0;

    // -- Scheduler state --
    in-out property <bool> scheduler-enabled: true;
    in-out property <[SchedRow]> scheduler-events;
    in-out property <bool> scheduler-show-editor: false;
    in-out property <string> scheduler-error: "";

    // -- Cart Wall state --
    in-out property <[CartRow]> cart-items;
    in-out property <string> cart-status: "";

    // -- Library state (live model; both Playout tab and Media screen bind here) --
    in-out property <[LibTrack]> library-tracks;
    in-out property <string> library-status: "";

    // -- Report state --
    in-out property <[ReportRow]> report-entries;
    in-out property <string> report-summary: "";
    in-out property <int> report-range: 1;

    // -- Ads state --
    in-out property <[AdRow]> ads-items;
    in-out property <bool> ads-show-editor: false;
    in-out property <string> ads-error: "";

    // -- Settings state --
    in-out property <[string]> settings-devices;
    in-out property <string> settings-device: "";
    in-out property <string> settings-device-note: "";
    in-out property <string> settings-xfade: "3.0 s";
    in-out property <string> settings-silence: "10 s";

    // -- Nav --
    callback navigate(int);

    // -- Player callbacks --
    callback play;
    callback pause;
    callback stop;
    callback next;
    callback prev;
    callback set-volume(float);

    // -- Library callbacks --
    callback import-files;
    callback library-health-check;
    callback library-search-changed(string);
    callback library-track-selected(int);
    callback library-track-double-clicked(int);

    // -- Playlist callbacks --
    callback playlist-play-item(int);
    callback playlist-remove-item(int);
    callback playlist-save;
    callback playlist-new;
    callback playlist-load(string);

    // -- Settings callbacks --
    callback activate-license(string);
    callback clear-license;
    callback settings-select-device(string);
    callback settings-refresh-devices;
    callback settings-xfade-inc;
    callback settings-xfade-dec;
    callback settings-silence-inc;
    callback settings-silence-dec;

    // -- Scheduler callbacks --
    callback scheduler-toggled(bool);
    callback scheduler-toggle-event(int);
    callback scheduler-delete-event(int);
    callback scheduler-run-event(int);
    callback scheduler-save-event(int, string, string, int, string, bool, bool, bool, bool, bool, bool, bool);

    // -- Cart Wall callbacks --
    callback cart-play(int);
    callback cart-delete(int);
    callback cart-add;

    // -- Report callbacks --
    callback report-range-changed(int);
    callback report-export;

    // -- Ads callbacks --
    callback ads-toggle-block(int);
    callback ads-delete-block(int);
    callback ads-run-block(int);
    callback ads-save-block(int, string, string, string, string, string, string, string, bool, bool, bool, bool, bool, bool, bool);

    VerticalLayout {
        // Top nav bar
        Rectangle {
            height: 44px;
            background: Theme.bg-secondary;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;

                Text {
                    text: "🦀 CrabBoss";
                    color: Theme.accent;
                    font-size: 15px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                Rectangle { width: 12px; }

                NavButton {
                    width: 90px;
                    label: "🏠 Home";
                    active: root.current-screen == 1;
                    clicked => { root.navigate(1); }
                }

                NavButton {
                    width: 90px;
                    label: "🎙 Playout";
                    active: root.current-screen == 2;
                    clicked => { root.navigate(2); }
                }

                NavButton {
                    width: 110px;
                    label: "📚 Media";
                    active: root.current-screen == 3;
                    clicked => { root.navigate(3); }
                }

                NavButton {
                    width: 110px;
                    label: "🗓 Scheduler";
                    active: root.current-screen == 5;
                    clicked => { root.navigate(5); }
                }

                NavButton {
                    width: 100px;
                    label: "🎛 Carts";
                    active: root.current-screen == 6;
                    clicked => { root.navigate(6); }
                }

                NavButton {
                    width: 100px;
                    label: "📊 Reports";
                    active: root.current-screen == 7;
                    clicked => { root.navigate(7); }
                }

                NavButton {
                    width: 80px;
                    label: "📢 Ads";
                    active: root.current-screen == 8;
                    clicked => { root.navigate(8); }
                }

                Rectangle { horizontal-stretch: 1; }

                NavButton {
                    width: 100px;
                    label: "⚙ Settings";
                    active: root.current-screen == 4;
                    clicked => { root.navigate(4); }
                }
            }
        }

        // -- Home --
        if (root.current-screen == 1) : HomeScreen {
            vertical-stretch: 1;
            station-name: root.station-name;
            now-playing-title: root.now-playing-title;
            now-playing-artist: root.now-playing-artist;
            is-playing: root.is-playing;
            track-count: root.track-count;
            playlist-count: root.playlist-count;
            upcoming-count: root.upcoming-count;

            go-playout => { root.navigate(2); }
            go-media => { root.navigate(3); }
            go-scheduler => { root.navigate(5); }
            go-cartwall => { root.navigate(6); }
        }

        // -- Playout --
        if (root.current-screen == 2) : HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: 300px;
                background: Theme.bg-primary;

                VerticalLayout {
                    PlayerPanel {
                        vertical-stretch: 1;
                        is-playing: root.is-playing;
                        now-playing-title: root.now-playing-title;
                        now-playing-artist: root.now-playing-artist;
                        current-time: root.current-time;
                        total-time: root.total-time;
                        volume: root.player-volume;
                        progress: root.player-progress;

                        play-pressed => { root.play(); }
                        pause-pressed => { root.pause(); }
                        stop-pressed => { root.stop(); }
                        next-pressed => { root.next(); }
                        prev-pressed => { root.prev(); }
                        volume-changed(v) => { root.set-volume(v); }
                    }

                    Rectangle {
                        height: 28px;
                        background: Theme.bg-secondary;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: "Ready";
                                color: Theme.text-dim;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-primary;

                VerticalLayout {
                    Rectangle {
                        height: 36px;
                        background: Theme.bg-secondary;

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 4px;

                            Rectangle {
                                width: 120px;
                                height: 28px;
                                border-radius: 6px;
                                background: Theme.accent;

                                Text {
                                    text: "📚 Library";
                                    color: white;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 120px;
                                height: 28px;
                                border-radius: 6px;
                                background: Theme.bg-primary;

                                TouchArea {
                                    clicked => { /* TODO: switch to playlist tab */ }
                                }

                                Text {
                                    text: "🎵 Playlist";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    LibraryPanel {
                        vertical-stretch: 1;
                        tracks: root.library-tracks;
                        status <=> root.library-status;

                        search-changed(text) => { root.library-search-changed(text); }
                        track-selected(idx) => { root.library-track-selected(idx); }
                        track-double-clicked(idx) => { root.library-track-double-clicked(idx); }
                        import-files => { root.import-files(); }
                        health-check => { root.library-health-check(); }
                    }
                }
            }
        }

        // -- Media Manager --
        if (root.current-screen == 3) : LibraryPanel {
            vertical-stretch: 1;
            tracks: root.library-tracks;
            status <=> root.library-status;

            search-changed(text) => { root.library-search-changed(text); }
            track-selected(idx) => { root.library-track-selected(idx); }
            track-double-clicked(idx) => { root.library-track-double-clicked(idx); }
            import-files => { root.import-files(); }
            health-check => { root.library-health-check(); }
        }

        // -- Settings --
        if (root.current-screen == 4) : SettingsScreen {
            vertical-stretch: 1;
            license-status: root.license-status;
            license-error: root.license-error;
            audio-engine: root.audio-engine;
            audio-device: root.audio-device;
            devices: root.settings-devices;
            selected-device <=> root.settings-device;
            device-note <=> root.settings-device-note;
            xfade-label <=> root.settings-xfade;
            silence-label <=> root.settings-silence;

            activate-license(key) => { root.activate-license(key); }
            clear-license => { root.clear-license(); }
            select-device(name) => { root.settings-select-device(name); }
            refresh-devices => { root.settings-refresh-devices(); }
            xfade-inc => { root.settings-xfade-inc(); }
            xfade-dec => { root.settings-xfade-dec(); }
            silence-inc => { root.settings-silence-inc(); }
            silence-dec => { root.settings-silence-dec(); }
        }

        // -- Scheduler --
        if (root.current-screen == 5) : SchedulerScreen {
            vertical-stretch: 1;
            scheduler-enabled <=> root.scheduler-enabled;
            events: root.scheduler-events;
            show-editor <=> root.scheduler-show-editor;
            editor-error <=> root.scheduler-error;

            scheduler-toggled(en) => { root.scheduler-toggled(en); }
            toggle-event(idx) => { root.scheduler-toggle-event(idx); }
            delete-event(idx) => { root.scheduler-delete-event(idx); }
            run-event(idx) => { root.scheduler-run-event(idx); }
            save-event(idx, name, time, action-idx, target, mon, tue, wed, thu, fri, sat, sun) => {
                root.scheduler-save-event(idx, name, time, action-idx, target, mon, tue, wed, thu, fri, sat, sun);
            }
        }

        // -- Cart Wall --
        if (root.current-screen == 6) : CartScreen {
            vertical-stretch: 1;
            carts: root.cart-items;
            status: root.cart-status;

            play-cart(idx) => { root.cart-play(idx); }
            delete-cart(idx) => { root.cart-delete(idx); }
            add-cart => { root.cart-add(); }
        }

        // -- Reports --
        if (root.current-screen == 7) : ReportScreen {
            vertical-stretch: 1;
            entries: root.report-entries;
            summary: root.report-summary;
            range-idx <=> root.report-range;

            set-range(idx) => { root.report-range-changed(idx); }
            export-csv => { root.report-export(); }
        }

        // -- Ads --
        if (root.current-screen == 8) : AdsScreen {
            vertical-stretch: 1;
            blocks: root.ads-items;
            show-editor <=> root.ads-show-editor;
            editor-error <=> root.ads-error;

            toggle-block(idx) => { root.ads-toggle-block(idx); }
            delete-block(idx) => { root.ads-delete-block(idx); }
            run-block(idx) => { root.ads-run-block(idx); }
            save-block(idx, name, spot, intro, outro, start, end, time, mon, tue, wed, thu, fri, sat, sun) => {
                root.ads-save-block(idx, name, spot, intro, outro, start, end, time, mon, tue, wed, thu, fri, sat, sun);
            }
        }
    }
}
